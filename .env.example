# 本地配置。不要分享或提交包含密钥的 .env。
# 四类模型可使用不同平台；支持 OpenAI-compatible API 和百炼 CosyVoice 原生 TTS。
# 每组 BASE_URL / API_KEY 必须成对填写；两项都留空才沿用公共配置。
# BASE_URL 填 API 根地址（通常包含 /v1），不要追加 /chat/completions 等路径。

# 公共默认平台（四组都独立配置时可留空）
MODEL_BASE_URL=https://api.evomap.ai/v1
MODEL_API_KEY=

# 视觉：需要图片输入和 JSON 输出，调用 /chat/completions
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=evomap-gpt-5.6-luna

# 对话：需要 JSON 输出，调用 /chat/completions
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=evomap-gpt-5.6-luna

# 语音识别：openai 调用 /audio/transcriptions；dashscope 使用 Fun-ASR WebSocket。
# 百炼北京：BASE_URL=https://dashscope.aliyuncs.com/api/v1，MODEL=fun-asr-realtime。
ASR_PROVIDER=dashscope
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_API_KEY=
ASR_MODEL=fun-asr-realtime

# 语音合成：openai 调用 /audio/speech；dashscope 使用 CosyVoice WebSocket。
# 百炼北京示例：BASE_URL=https://dashscope.aliyuncs.com/api/v1
# MODEL=cosyvoice-v3-flash，系统音色如 longanrou_v3 / longanhuan_v3。
# v3.5 无预设音色，须先创建与模型匹配的设计或复刻音色。
TTS_PROVIDER=dashscope
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_API_KEY=
TTS_MODEL=cosyvoice-v3-flash

# 两个人格的默认音色 ID；系统音色或已授权的复刻音色均可。
# 音色必须属于 TTS 平台且与 TTS_MODEL 兼容，不填写 .pth 文件路径。
VOICE_AQI=longanrou_v3
VOICE_ANAO=longanhuan_v3

# 前端声音卡片：选择卡片后使用对应音色 ID
VOICE_VELVET=longanrou_v3
VOICE_SPARKLE=longanhuan_v3
VOICE_CEDAR=longanzhi_v3
VOICE_BREEZE=longanyang
REACHY_LOL_PORT=8768
